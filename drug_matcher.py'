import re
import os
from dotenv import load_dotenv
import psycopg2
from rapidfuzz import fuzz

load_dotenv()

DB_CONFIG = {
    "dbname": os.getenv("DB_NAME"),
    "user": os.getenv("DB_USER"),
    "password": os.getenv("DB_PASSWORD"),
    "host": os.getenv("DB_HOST"),
    "port": os.getenv("DB_PORT","5432"),
}


HIGH_CONFIDENCE = 0.90
REVIEW_CONFIDENCE = 0.75


def normalize_text(text):
    if not text:
        return ""

    text = str(text).lower().strip()

    text = text.replace("|", "i")
    text = text.replace("0", "o")

    text = re.sub(r"[^a-z0-9\s-]", " ", text)
    text = re.sub(r"\s+", " ", text)

    return text.strip()


def get_drugs():
    conn = psycopg2.connect(**DB_CONFIG)

    try:
        with conn.cursor() as cursor:
            cursor.execute("""
                SELECT
                    id,
                    drug_name,
                    generic_name,
                    dosage_form,
                    ndc_code
                FROM drugs
                WHERE drug_name IS NOT NULL
            """)

            rows = cursor.fetchall()

    finally:
        conn.close()

    drugs = []

    for row in rows:
        drug_id = row[0]
        drug_name = row[1]
        generic_name = row[2]
        dosage_form = row[3]
        ndc_code = row[4]

        drugs.append({
            "id": drug_id,
            "drug_name": drug_name,
            "generic_name": generic_name,
            "dosage_form": dosage_form,
            "ndc_code": ndc_code,
            "normalized_name": normalize_text(drug_name),
            "normalized_generic": normalize_text(generic_name),
        })

    return drugs


# Load database once when the application starts.
DRUGS = get_drugs()


def calculate_score(ocr_text, drug):
    ocr = normalize_text(ocr_text)

    name = drug["normalized_name"]
    generic = drug["normalized_generic"]

    if not ocr or not name:
        return 0.0

    # Very short OCR is inherently unreliable.
    if len(ocr) <= 2:
        return 0.0

    name_ratio = fuzz.ratio(ocr, name) / 100.0
    name_partial = fuzz.partial_ratio(ocr, name) / 100.0

    if generic:
        generic_ratio = fuzz.ratio(ocr, generic) / 100.0
    else:
        generic_ratio = 0.0

    # Main evidence comes from the medicine name.
    score = (
        name_ratio * 0.70 +
        name_partial * 0.20 +
        generic_ratio * 0.10
    )

    # Short OCR should not become HIGH simply because of
    # a partial match.
    if len(ocr) <= 4:
        score = min(score, 0.74)

    return round(score, 4)


def get_confidence_status(score):
    if score >= HIGH_CONFIDENCE:
        return "HIGH"

    if score >= REVIEW_CONFIDENCE:
        return "REVIEW"

    return "LOW"


def match_drug(ocr_text, limit=5):
    normalized_ocr = normalize_text(ocr_text)

    if not normalized_ocr:
        return []

    results = []

    for drug in DRUGS:

        score = calculate_score(
            normalized_ocr,
            drug
        )

        results.append({
            "id": drug["id"],
            "drug_name": drug["drug_name"],
            "generic_name": drug["generic_name"],
            "dosage_form": drug["dosage_form"],
            "ndc_code": drug["ndc_code"],
            "confidence": score,
            "status": get_confidence_status(score)
        })

    results.sort(
        key=lambda item: item["confidence"],
        reverse=True
    )

    return results[:limit]


def print_matches(ocr_text, matches):

    print()
    print("=" * 65)
    print(f"OCR TEXT: {ocr_text}")
    print("=" * 65)

    if not matches:
        print("No medicine matches found.")
        return

    best = matches[0]

    print()
    print("BEST MATCH")
    print("-" * 65)

    print(f"Medicine:   {best['drug_name']}")
    print(f"Generic:    {best['generic_name']}")
    print(f"Dosage:     {best['dosage_form']}")
    print(f"NDC:        {best['ndc_code']}")
    print(f"Confidence: {best['confidence']:.2%}")
    print(f"Status:     {best['status']}")

    print()
    print("TOP CANDIDATES")
    print("-" * 65)

    for index, match in enumerate(matches, 1):

        print(
            f"{index}. "
            f"{match['drug_name']} | "
            f"{match['generic_name']} | "
            f"{match['confidence']:.2%} | "
            f"{match['status']}"
        )


if __name__ == "__main__":

    test_inputs = [
        "Acthar",
        "Aceta",
        "MULBA",
        "S",
        "Nam"
    ]

    for test_text in test_inputs:

        try:
            matches = match_drug(test_text)

            print_matches(
                test_text,
                matches
            )

        except Exception as error:

            print()
            print("ERROR:")
            print(error)
